<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="D:\ai-content-detector\ai-detector\backend\venv\Scripts\python.exe"
                   arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                   workingDirectory="D:\ai-content-detector\ai-detector\backend"
                   startupTimeLimit="60"
                   startupRetryCount="3"
                   stdoutLogEnabled="true"
                   stdoutLogFile="D:\ai-content-detector\ai-detector\backend\logs\stdout"
                   requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
